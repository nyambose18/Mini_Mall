# Mini Mall server configuration
# Copy this file to .env and edit as needed.

PORT=4000

# Leave empty to let the server start its own local MongoDB.
# Set a connection string to use an existing MongoDB instead.
MONGO_URI=

# Data folder for the auto-started local MongoDB.
MONGO_DATA_DIR=./data/mongodb

# Change this to a long random string before sharing the app.
JWT_SECRET=dev-mini-mall-secret-change-me

# Set to false to disable the one-click persona sign-in buttons.
DEMO_LOGIN=true

# Demo rules (amounts in rand).
DELIVERY_FEE=50
OUTLYING_DELIVERY_FEE=75
EFT_EXPIRY_HOURS=24
COD_DISPATCH_WORKING_DAYS=2
REFUND_WINDOW_DAYS=7