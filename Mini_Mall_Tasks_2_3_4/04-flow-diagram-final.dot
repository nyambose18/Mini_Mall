digraph G { graph [rankdir=TB,bgcolor="white",pad="0.35",nodesep="0.3",ranksep="0.45"]; node [shape=box,style="rounded,filled",fillcolor="#e2eefc",fontname="DejaVu Sans",fontsize=12,margin="0.16"]; edge [fontname="DejaVu Sans",fontsize=10]; a [label="Browse\nBuyer"]; b [label="Add to Cart\nBuyer / System"]; c [label="Place order\nSystem"]; d [label="Payment route\nBuyer / System",shape=diamond]; e [label="EFT result\nSystem",shape=diamond]; s [label="Seller ships\nSeller"]; r [label="Confirm receipt\nBuyer"]; f [label="Refund decision\nSystem (admin result)",shape=diamond]; z [label="Closed case\nSystem"]; x [label="Correct / retry / cancel\nBuyer / System"]; a -> b -> c -> d; c -> b [label="Insufficient stock",style=dashed,color=red];d -> e [label="EFT"]; e -> s [label="Confirmed"]; e -> x [label="Failed / pending",style=dashed,color=red]; x -> d [label="Retry same order"];q [label="COD accepted?\nSystem",shape=diamond]; d -> q [label="COD"]; q -> s [label="Eligible; cash due"]; q -> x [label="Rejected",style=dashed,color=red];s -> r [label="Delivered; record cash separately"]; r -> f [label="Optional request"]; f -> z [label="Approved: return/refund rule"]; f -> z [label="Rejected: show reason",style=dashed,color=red];}